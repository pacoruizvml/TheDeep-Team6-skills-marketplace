# Copy to .env or set in your shell. All optional.
PORT=3000
# Shared secret for MCP endpoints (recommended: Dev Tunnel runs with anonymous access)
MCP_API_KEY=
# Also require ?key= on web pages (review, dealer inbox, audit)
REQUIRE_KEY_FOR_WEB=false
# Set to "off" to force a human to type the dealer reply in the dealer inbox page
SCRIPTED_DEALER_REPLY=on
# Override the scripted dealer reply text
DEALER_REPLY_TEXT=
# Fix the synthetic data anchor date (ISO) so audience counts stay identical across days
DEMO_ANCHOR_DATE=
DATA_SEED=20261124
# Alternative file for get_external_signals
EXTERNAL_SIGNALS_FILE=
