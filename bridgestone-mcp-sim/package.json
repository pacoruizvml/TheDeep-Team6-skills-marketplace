{
  "name": "bridgestone-mcp-sim",
  "version": "0.1.0",
  "description": "SIMULATED Bridgestone Reactive Guardrails agents as MCP servers (synthetic data, no Adobe connection)",
  "scripts": {
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start:signal": "tsx --env-file-if-exists=.env src/server.ts --agent signal --port 3001",
    "start:campaign": "tsx --env-file-if-exists=.env src/server.ts --agent campaign --port 3002",
    "start:compliance": "tsx --env-file-if-exists=.env src/server.ts --agent compliance --port 3003",
    "start:governance": "tsx --env-file-if-exists=.env src/server.ts --agent governance --port 3004",
    "typecheck": "tsc --noEmit",
    "e2e": "tsx scripts/e2e.ts",
    "export-data": "tsx scripts/export-data.ts",
    "reset": "tsx scripts/reset.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "express": "^5.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.9"
  }
}
